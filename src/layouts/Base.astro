---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Consent from "../components/Consent.astro";
import "../styles/global.css";

interface Props { title: string; description?: string; active?: string }
const { title, description = "Tours, food and day trips in Rome, booked in a couple of taps.", active = "" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
    <script is:inline>
      // The consent gate lives at the end of the body, so anything the page
      // wants to report happens before it exists. These stubs take the calls and
      // hold them; the gate drains the queue when it loads, and sends nothing
      // unless the visitor has said yes.
      window.rsmQ = [];
      window.rsmTrack = (name, params) => window.rsmQ.push(["track", name, params]);
      window.rsmIdentify = (person) => window.rsmQ.push(["identify", person]);
    </script>
  </head>
  <body>
    <Header active={active} />
    <main><slot /></main>
    <Footer />
    <Consent />
    <slot name="after" />
  </body>
</html>
