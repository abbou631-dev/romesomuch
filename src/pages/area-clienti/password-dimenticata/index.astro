---
// Asks for the client's email; the server mails a one-hour reset link.
import Shell from "../../../components/private/Shell.astro";
import logo from "../../../assets/logo.svg";
---
<Shell title="Password dimenticata · RomeSoMuch" bodyClass="login">
  <form method="post" action="/api/portal/forgot" class="login-box">
    <img class="logo" src={logo.src} alt="RomeSoMuch" />
    <h1>Password dimenticata</h1>
    <p class="mute">Scrivi l'email con cui entri: ti mandiamo un link per sceglierne una nuova, valido un'ora.</p>
    <label>Email<input type="email" name="email" autocomplete="username" required autofocus /></label>
    <p class="login-error" id="error" role="alert" hidden></p>
    <button type="submit" class="btn primary">Mandami il link</button>
    <a class="link" href="/area-clienti/login/">Torna all'accesso</a>
  </form>
  <script>
    const messages: Record<string, string> = {
      troppi: "Troppe richieste. Riprova tra 15 minuti.",
      scaduto: "Il link è scaduto o è già stato usato. Chiedine uno nuovo.",
    };
    const code = new URLSearchParams(location.search).get("e");
    const box = document.getElementById("error")!;
    if (code && messages[code]) {
      box.textContent = messages[code];
      box.hidden = false;
    }
  </script>
</Shell>
