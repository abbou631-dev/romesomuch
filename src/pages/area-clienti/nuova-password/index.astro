---
// Where the emailed link lands: the token rides along in a hidden field.
import Shell from "../../../components/private/Shell.astro";
import logo from "../../../assets/logo.svg";
---
<Shell title="Nuova password · RomeSoMuch" bodyClass="login">
  <form method="post" action="/api/portal/reset" class="login-box">
    <img class="logo" src={logo.src} alt="RomeSoMuch" />
    <h1>Nuova password</h1>
    <input type="hidden" name="t" id="token" />
    <label>Nuova password<input type="password" name="password" autocomplete="new-password" minlength="8" required autofocus /></label>
    <label>Ripeti la password<input type="password" name="again" autocomplete="new-password" minlength="8" required /></label>
    <p class="login-error" id="error" role="alert" hidden></p>
    <button type="submit" class="btn primary">Salva ed entra</button>
  </form>
  <script>
    const query = new URLSearchParams(location.search);
    (document.getElementById("token") as HTMLInputElement).value = query.get("t") ?? "";
    // The token is in the address bar only until the page has read it.
    history.replaceState(null, "", location.pathname + (query.get("e") ? `?e=${query.get("e")}` : ""));
    const messages: Record<string, string> = {
      corta: "La password deve avere almeno 8 caratteri.",
      diverse: "Le due password non coincidono.",
    };
    const code = query.get("e");
    const box = document.getElementById("error")!;
    if (code && messages[code]) {
      box.textContent = messages[code];
      box.hidden = false;
    }
  </script>
</Shell>
