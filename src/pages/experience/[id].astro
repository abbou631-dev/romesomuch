---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Gallery from "../../components/Gallery.astro";
import Rail from "../../components/Rail.astro";
import BookingPanel from "../../components/BookingPanel.astro";
import MeetingMap from "../../components/MeetingMap.astro";
import { cancellationDefault, categoryName } from "../../lib/site";

export const getStaticPaths = (async () => {
  const all = (await getCollection("experiences")).sort((a, b) => a.data.order - b.data.order);
  return all.map((exp) => ({ params: { id: exp.id }, props: { exp } }));
}) satisfies GetStaticPaths;

const { exp } = Astro.props;
const d = exp.data;
const { Content } = await render(exp);
const all = (await getCollection("experiences")).sort((a, b) => a.data.order - b.data.order);
const related = all.filter((e) => e.data.category === d.category && e.id !== exp.id).slice(0, 4);
---
<Base title={`${d.title} — RomeSoMuch`} description={d.blurb} active={d.category}>
  <div class="wrap">
    <header class="dhead">
      <p class="crumb" style="opacity:1;color:var(--muted)">
        <a href="/">Home</a> / <a href={`/experiences/${d.category}/`}>{categoryName(d.category)}</a>
      </p>
      <h1 style="font-size:clamp(28px,4.6vw,54px)">{d.title}</h1>
      <p style="margin-top:10px;color:var(--muted);font-size:15px;font-weight:500">{d.blurb}</p>
    </header>
  </div>

  <Gallery images={d.images} title={d.title} />

  <div class="wrap">
    <div class="detail">
      <div>

        <dl class="facts">
          <div><dt>Length</dt><dd>{d.durationLabel}</dd></div>
          {d.maxGuests && <div><dt>Group size</dt><dd>Up to {d.maxGuests}</dd></div>}
          {d.languages && <div><dt>Languages</dt><dd>{d.languages}</dd></div>}
          {d.meetingPoint && <div><dt>Meeting point</dt><dd>{d.meetingPoint}</dd></div>}
        </dl>

        <div class="prose">
          <h2>What you do</h2>
          <Content />
          <h2>Included</h2>
          <ul class="incl">{d.included.map((i) => <li>{i}</li>)}</ul>
          <h2>Cancellation</h2>
          <p>{d.cancellationPolicy ?? cancellationDefault}</p>
          {d.meetingCoords && d.meetingPoint && (
            <MeetingMap coords={d.meetingCoords} address={d.meetingPoint} title={d.title} />
          )}
        </div>
      </div>

      <BookingPanel exp={exp} />
    </div>
  </div>

  <script
    is:inline
    define:vars={{ id: exp.id, name: d.title, category: d.category, price: d.price }}
  >
    // Remembered for the rest of the session so a message sent later from the
    // contact page still says which experience the visitor had been reading.
    // It lives here rather than in the form, because a page with a working
    // calendar carries no form at all.
    try {
      sessionStorage.setItem("rsm-last", `${name} (/experience/${id}/)`);
    } catch {
      /* storage switched off simply means less context in the email */
    }

    window.rsmTrack?.("ViewContent", {
      content_type: "product",
      content_ids: [id],
      content_name: name,
      content_category: category,
      value: price,
      currency: "EUR",
    });
  </script>

  {related.length > 0 && (
    <Rail title={`More ${categoryName(d.category)}`} items={related} href={`/experiences/${d.category}/`} tone="tone" />
  )}
</Base>

