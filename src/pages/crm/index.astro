---
// The agency CRM: an empty shell that src/lib/crm/app.ts fills from
// /api/crm. functions/crm/_middleware.js serves it only after login.
import Shell from "../../components/private/Shell.astro";
import logo from "../../assets/logo.svg";

// The second value marks what only the owner sees; the team gets Clienti
// and Video (the server enforces the same, see functions/api/crm).
const nav: [string, string, boolean][] = [
  ["#/", "Panoramica", true],
  ["#/clienti", "Clienti", false],
  ["#/video", "Video", false],
  ["#/pagamenti", "Pagamenti", true],
  ["#/promo", "Promo", true],
  ["#/report", "Report", true],
  ["#/collegamenti", "Collegamenti", true],
  ["#/team", "Team", true],
];
---
<Shell title="RomeSoMuch CRM">
  <header class="side">
    <a href="#/" class="brand"><img class="logo" src={logo.src} alt="RomeSoMuch" /><span class="tag">CRM</span></a>
    <nav>{nav.map(([href, label, owner]) => <a href={href} data-nav data-owner={owner ? "" : undefined}>{label}</a>)}</nav>
    <form method="post" action="/api/crm/logout" class="logout"><button type="submit" class="link">Esci</button></form>
  </header>
  <main id="view" aria-live="polite"></main>
  <dialog id="dialog"></dialog>
  <div id="toast" role="status"></div>
  <script>
    import { start } from "../../lib/crm/app";
    start();
  </script>
</Shell>
