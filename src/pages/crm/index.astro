---
// The CRM's home: pick Tour (the experiences sold on the site) or Clienti B2B
// (Visibilità costante and the rest of the agency work). Gated like every page
// under /crm by functions/crm/_middleware.js.
import Shell from "../../components/private/Shell.astro";
import logo from "../../assets/logo.svg";
---
<Shell title="RomeSoMuch CRM" bodyClass="crm-home">
  <main class="choose">
    <img class="logo" src={logo.src} alt="RomeSoMuch" />
    <h1>Cosa apri?</h1>
    <div class="doors">
      <a class="door" href="/crm/tour/">
        <span class="tag">Prenotazioni sul sito</span>
        <strong>Tour</strong>
        <small>Prenotazioni, cancellazioni e rimborsi, calendario e prezzi delle esperienze</small>
      </a>
      <a class="door" href="/crm/b2b/">
        <span class="tag">Agenzia</span>
        <strong>Clienti B2B</strong>
        <small>Visibilità costante, video, pagamenti, promo, UGC, leads e report</small>
      </a>
    </div>
    <form method="post" action="/api/crm/logout"><button type="submit" class="link">Esci</button></form>
  </main>
  <script>
    // Links from before the split (/crm/#/cliente/3, in old emails and
    // redirects) belong to the B2B side.
    if (location.hash.length > 1) location.replace(`/crm/b2b/${location.hash}`);
    // The team only works on the B2B side: no choice to make.
    else fetch("/api/crm/me").then((r) => r.json()).then((me) => {
      if (me.role === "team") location.replace("/crm/b2b/");
    }).catch(() => {});
  </script>
</Shell>
