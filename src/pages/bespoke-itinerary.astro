---
// Link-only landing page for the bespoke itinerary service. Nothing on the site
// links here and search engines are told to skip it; people arrive from a link
// we send them.
//
// Offer structure after Hormozi (promise, cost of the alternative, the stack,
// risk reversal, limited capacity, objections, one repeated action), laid out in
// the light, comparison-led style of hirewinning.com.
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import Shot from "../components/Shot.astro";
import logo from "../assets/logo.png";

// DRAFT: price, turnaround and guarantee are proposals until the owner confirms them.
const PRICE = "€149";
const DRAFT_DAYS = 5;

const stats = [
  { n: "1.5M+", l: "People in our community" },
  { n: "0%", l: "Written by AI" },
  { n: "48h", l: "To hear back from us" },
  { n: `${DRAFT_DAYS} days`, l: "To your first draft" },
];

const strip = [
  { photo: "colosseum-hero", label: "Colosseum" },
  { photo: "aventine-keyhole", label: "Aventine" },
  { photo: "borghese-lake", label: "Villa Borghese" },
  { photo: "cruise-saint-peters-sunset", label: "Tiber" },
  { photo: "spanish-steps", label: "Spanish Steps" },
  { photo: "appia-cyclist", label: "Appia Antica" },
  { photo: "roman-lane", label: "Centro storico" },
];

// Icons are 24px stroke paths.
const icon = {
  chat: "M4 5h16v11H9l-5 4z M8.5 10.5h.01 M12 10.5h.01 M15.5 10.5h.01",
  calendar: "M4 6h16v14H4z M4 10h16 M8 3v4 M16 3v4",
  fork: "M7 3v8a2 2 0 0 0 4 0V3 M9 11v10 M16 3c-2 1-3 4-3 7h3v11",
  ticket: "M3 8a2 2 0 0 0 0 4v4h18v-4a2 2 0 0 1 0-4V4H3z M14 4v16",
  pin: "M12 21s-7-6.5-7-12a7 7 0 0 1 14 0c0 5.5-7 12-7 12z M12 11.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z",
  edit: "M4 20h4L19 9l-4-4L4 16z M13 7l4 4",
  phone: "M5 4h4l2 5-3 2a11 11 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 6a2 2 0 0 1 2-2z",
  umbrella: "M3 12a9 9 0 0 1 18 0z M12 12v6a2 2 0 0 0 4 0 M12 3v1",
  shield: "M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z M8.5 12l2.5 2.5 4.5-5",
  user: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M4 21a8 8 0 0 1 16 0",
  sun: "M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10z M12 1v2 M12 21v2 M4.2 4.2l1.4 1.4 M18.4 18.4l1.4 1.4 M1 12h2 M21 12h2",
};

const stack = [
  { i: icon.chat, t: "A brief with a Roman", b: "A short call or a written brief. What you love, what you hate, how you walk, how you eat." },
  { i: icon.calendar, t: "Every day, planned", b: "Morning to night, in the order that works on foot, with how long each thing really takes." },
  { i: icon.fork, t: "Where to eat, every meal", b: "The places we eat at ourselves, matched to your taste and budget, with what to order." },
  { i: icon.ticket, t: "Tickets and timing", b: "What to book ahead, when it sells out, which entrance and which slot beats the crowd." },
  { i: icon.pin, t: "A map on your phone", b: "Every stop pinned and grouped by day. Never stand on a corner wondering where next." },
  { i: icon.edit, t: "Rewrites until it is yours", b: "Tell us what is off in the draft and we rewrite it, as many rounds as it takes." },
];

const bonuses = [
  { i: icon.phone, t: "A Roman on WhatsApp", b: "Rain, a closed museum, carbonara at 11pm: message us during your trip and a person answers." },
  { i: icon.umbrella, t: "Rainy-day plan B", b: "An indoor alternative for every outdoor day, already worked out." },
];

const compare = [
  ["Written by", "People who live in Rome", "You, from blogs", "A language model"],
  ["Built around your taste", "Yes, from your brief", "If you find it", "Generic"],
  ["Knows what closed last month", "Yes", "Rarely", "No"],
  ["Right order on foot", "Yes", "Trial and error", "Often wrong"],
  ["Tickets and time slots", "Told what and when", "Found at the door", "Not checked"],
  ["Help while you are there", "WhatsApp with a Roman", "None", "None"],
  ["Your time", "2 minutes", "Evenings of tabs", "Plus fact-checking"],
];

const steps = [
  { i: icon.chat, t: "Tell us about you", b: "Fill in the short form. Two minutes, no commitment, nothing to pay." },
  { i: icon.user, t: "We talk", b: "A Roman answers within 48 hours, goes through your brief and confirms." },
  { i: icon.calendar, t: "We plan", b: `Your first draft arrives within ${DRAFT_DAYS} days. Rewrites until it feels like yours.` },
  { i: icon.sun, t: "You arrive", b: "Every day planned, every booking listed, and a Roman on WhatsApp." },
];

const faq = [
  { q: "Is any of this written by AI?", a: "No. Every itinerary is researched and written by people who live in Rome and walk these streets every week. A list generator can tell you the Colosseum is popular; it cannot tell you which bar we go to after." },
  { q: "How is this different from a free list online?", a: "A list is the same for everyone. This is built around you: your pace, your food, your budget, where you are staying, and the order that actually works on the ground." },
  { q: "When do I pay?", a: "After we have read your brief and confirmed we can plan your trip. If we cannot, you pay nothing." },
  { q: "How far ahead should I ask?", a: `Your first draft arrives within ${DRAFT_DAYS} days of your brief. Ask at least two weeks before you travel so there is time to secure the tickets that sell out.` },
  { q: "Do I have to book your tours?", a: "No. We recommend what fits you, whoever runs it. If one of our own experiences is the right fit we will say so, and if it is not, we will not put it in." },
  { q: "We are a family, a couple, travelling for work. Does it still work?", a: "That is what the brief is for. Kids, mobility, dietary needs, a meeting every morning: tell us and the plan is built around it." },
];

// Client success stories. Every slot is a placeholder until a real client agrees to be quoted:
// fill in name, trip, quote and results from what they actually said and did.
const stories = [1, 2, 3].map(() => ({
  name: "Client name",
  trip: "Who travelled, how many days, when",
  quote: "Their words about the trip, exactly as they wrote or said them.",
  results: [
    { n: "Result", l: "Something measurable from their trip" },
    { n: "Result", l: "A second one, if there is one" },
  ],
}));

const Arrow = `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---
<Base
  title="Your Rome, planned by Romans — RomeSoMuch"
  description="A bespoke Rome itinerary written by people who live here, built around what you love. No AI."
  unlisted
>
  <div class="bs">
    <nav class="bs-nav wrap">
      <a href="/" class="bs-logo"><Image src={logo} alt="RomeSoMuch" width={140} densities={[1, 2]} loading="eager" /></a>
      <div class="bs-links">
        <a href="#inside">What you get</a>
        <a href="#compare">Compare</a>
        <a href="#how">How it works</a>
        <a href="#faq">FAQ</a>
      </div>
      <a class="bs-btn sm" href="#start">Start my itinerary <Fragment set:html={Arrow} /></a>
    </nav>

    <!-- 1. The promise -->
    <header class="bs-hero wrap">
      <p class="bs-pill">
        <span class="bs-faces">
          {strip.slice(0, 4).map((s) => <Shot image={{ photo: s.photo }} alt="" sizes="40px" loading="eager" />)}
        </span>
        <span>Trusted by a community of <b>1.5M+ people</b> in Rome</span>
      </p>
      <h1>
        Rome, planned around you<br />
        <span class="grad">by people who live here.</span><br />
        Not by AI.
      </h1>
      <p class="bs-sub">
        Tell us how you like to travel. A Roman builds your trip day by day: what to see, where to eat,
        what to book and when. You just show up.
      </p>
      <div class="bs-ctas">
        <a class="bs-btn" href="#start">Start my itinerary <Fragment set:html={Arrow} /></a>
        <a class="bs-btn ghost" href="#inside">See what you get</a>
      </div>
      <p class="bs-fine"><span class="dot"></span>{PRICE} per trip · nothing to pay until we confirm we can plan it</p>

      <dl class="bs-stats">
        {stats.map((s) => <div><dt>{s.n}</dt><dd>{s.l}</dd></div>)}
      </dl>
    </header>

    <div class="bs-strip" aria-hidden="true">
      <div class="bs-track">
        {[...strip, ...strip].map((s) => (
          <figure><Shot image={{ photo: s.photo }} alt="" sizes="240px" /><figcaption>{s.label}</figcaption></figure>
        ))}
      </div>
    </div>

    <!-- 1b. Proof: client stories -->
    <section class="bs-sec wrap bs-stories" aria-roledescription="carousel" aria-label="Client success stories">
      <p class="bs-kick">Client success stories</p>
      <div class="bs-head-row">
        <h2>Real trips, <span class="grad">real travellers</span></h2>
        <p class="bs-lead">What people who let a Roman plan their trip say about it, in their own words.</p>
      </div>
      <div class="bs-st-track" data-track>
        {stories.map((st) => (
          <div class="bs-st-slide">
            <article class="bs-st-card">
              <div class="bs-st-top">
                <span class="bs-st-avatar" aria-hidden="true"></span>
                <div><h3>{st.name}</h3><p>{st.trip}</p></div>
              </div>
              <blockquote>"{st.quote}"</blockquote>
              <dl class="bs-st-res">
                {st.results.map((r) => <div><dt>{r.n}</dt><dd>{r.l}</dd></div>)}
              </dl>
            </article>
            {[1, 2, 3].map(() => (
              <div class="bs-st-media"><span>Client photo or video</span><i class="bs-play" aria-hidden="true"></i></div>
            ))}
          </div>
        ))}
      </div>
      <div class="bs-st-nav">
        <div class="bs-st-dots">
          {stories.map((_, n) => <button type="button" aria-label={`Story ${n + 1}`} data-dot={n}></button>)}
        </div>
        <span class="bs-st-bar"><i data-bar></i></span>
        <button type="button" class="bs-st-arrow" data-prev aria-label="Previous story"><Fragment set:html={Arrow} /></button>
        <button type="button" class="bs-st-arrow" data-next aria-label="Next story"><Fragment set:html={Arrow} /></button>
      </div>
    </section>

    <!-- 2. Who plans it -->
    <section class="bs-sec wrap">
      <p class="bs-kick">Meet your planners</p>
      <div class="bs-head-row">
        <h2>Real Romans, <span class="grad">not a call centre</span></h2>
        <p class="bs-lead">
          The people who plan your trip are the same people who find the places our 1.5 million followers see
          every day. They live here, eat here, and walk these streets every week.
        </p>
      </div>
      <div class="bs-people">
        {[1, 2, 3, 4].map(() => (
          <article class="bs-person">
            <div class="bs-person-ph"><span>Photo of a planner</span></div>
            <p class="bs-badge">Lives in Rome</p>
            <h3>Name to add</h3>
            <p>Their neighbourhood and what they know best</p>
          </article>
        ))}
      </div>
    </section>

    <!-- 3. The stack -->
    <section class="bs-sec bs-soft" id="inside">
      <div class="wrap">
        <p class="bs-kick center">What you get</p>
        <h2 class="center">Everything a Roman friend<br /><span class="grad">would tell you, written down.</span></h2>
        <div class="bs-grid">
          {stack.map((s) => (
            <article class="bs-card">
              <span class="bs-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={s.i} /></svg></span>
              <h3>{s.t}</h3><p>{s.b}</p>
            </article>
          ))}
        </div>
        <div class="bs-bonuses">
          {bonuses.map((s) => (
            <article class="bs-card bonus">
              <span class="bs-tag">Bonus · included</span>
              <span class="bs-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={s.i} /></svg></span>
              <h3>{s.t}</h3><p>{s.b}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. What would you rather pay -->
    <section class="bs-sec wrap bs-pay">
      <div>
        <p class="bs-kick">The real cost</p>
        <h2>What would you<br /><span class="grad">rather spend?</span></h2>
        <p class="bs-big">{PRICE} or your holiday</p>
        <p class="bs-lead">
          Planning Rome yourself looks free. You pay for it in evenings of research, days criss-crossing the
          map, sold-out slots and dinners next to the monument at twice the price.
        </p>
        <a class="bs-btn" href="#start">Start my itinerary <Fragment set:html={Arrow} /></a>
      </div>
      <div class="bs-vs">
        <article class="bs-offer on">
          <header><span class="chip">Bespoke</span><h3>Planned by a Roman</h3></header>
          <ul>
            <li>Built on your brief</li><li>Every day in the right order</li><li>Tickets and timing sorted</li>
            <li>A Roman on WhatsApp</li><li class="price">{PRICE} per trip</li>
          </ul>
          <p class="extra"><span>What else it costs you</span>Two minutes.</p>
        </article>
        <span class="bs-vs-dot">VS</span>
        <article class="bs-offer">
          <header><span class="chip">DIY</span><h3>Planning it yourself</h3></header>
          <ul>
            <li>The same lists as everyone</li><li>Zig-zagging the city</li><li>Finding out at the door</li>
            <li>Nobody to ask</li><li class="price">"Free"</li>
          </ul>
          <p class="extra"><span>What else it costs you</span>Evenings of tabs, lost hours on the ground, tourist-trap dinners.</p>
        </article>
      </div>
    </section>

    <!-- 5. Comparison -->
    <section class="bs-sec bs-soft" id="compare">
      <div class="wrap">
        <p class="bs-kick center">How we compare</p>
        <h2 class="center"><span class="grad">RomeSoMuch</span> vs. doing it yourself vs. AI</h2>
        <div class="bs-table" role="table">
          <div class="bs-tr bs-th" role="row">
            <span role="columnheader"></span>
            <span role="columnheader" class="us">RomeSoMuch</span>
            <span role="columnheader">On your own</span>
            <span role="columnheader">AI itinerary</span>
          </div>
          {compare.map(([k, a, b, c]) => (
            <div class="bs-tr" role="row">
              <span role="rowheader">{k}</span>
              <span role="cell" class="us"><i class="ok"></i>{a}</span>
              <span role="cell"><i class="no"></i>{b}</span>
              <span role="cell"><i class="no"></i>{c}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Steps -->
    <section class="bs-sec wrap" id="how">
      <p class="bs-kick center">How to get started</p>
      <h2 class="center">Planning your Rome trip<br />is <span class="grad">simple.</span></h2>
      <p class="bs-lead center">We handle the research, the order, the bookings list and the backup plans. You handle the gelato.</p>
      <ol class="bs-steps">
        {steps.map((s, n) => (
          <li>
            <div class="bs-step-top">
              <span class="bs-ico lg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={s.i} /></svg></span>
              <span class="bs-step-n">0{n + 1}</span>
            </div>
            <span class="bs-node"></span>
            <h3>{s.t}</h3><p>{s.b}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 7. Guarantee + capacity -->
    <section class="bs-sec wrap">
      <div class="bs-guar">
        <span class="bs-ico xl"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icon.shield} /></svg></span>
        <div>
          <p class="bs-kick">Our guarantee</p>
          <h2>Love it, <span class="grad">or you do not pay.</span></h2>
          <p class="bs-lead">
            If the first draft does not feel like your trip, we rewrite it. If it still is not right, we refund
            you in full. And because every plan is written by hand, we take on only a few trips a month: if your
            dates are fixed, ask early.
          </p>
        </div>
      </div>
    </section>

    <!-- 8. FAQ -->
    <section class="bs-sec bs-soft" id="faq">
      <div class="wrap bs-faq-wrap">
        <div>
          <p class="bs-kick">FAQ</p>
          <h2>Frequently asked <span class="grad">questions</span></h2>
          <p class="bs-lead">Something else? Ask it in the form, we read everything.</p>
        </div>
        <div class="bs-faq">
          {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
      </div>
    </section>

    <!-- 9. The one action -->
    <section class="bs-sec wrap" id="start">
      <div class="bs-final">
        <div class="bs-final-copy">
          <p class="bs-kick light">Start here</p>
          <h2>Tell us how you<br />like to travel.</h2>
          <p>We answer within 48 hours. Nothing to pay until we confirm we can plan your trip.</p>
          <ul>
            <li>Made by humans who live in Rome</li>
            <li>Built on your preferences, not a template</li>
            <li>Rewrites until it is right, or your money back</li>
          </ul>
        </div>
        <div class="bs-form">
          <EnquiryForm
            kind="itinerary"
            submit="Start my itinerary"
            fields={[
              { name: "name", label: "Your name", required: true },
              { name: "email", label: "Email", type: "email", required: true },
              { name: "dates", label: "When are you in Rome?", required: true, help: "Arrival and departure dates, even roughly." },
              { name: "travellers", label: "Who is travelling?", help: "E.g. a couple, two adults and a 7-year-old, four friends." },
              {
                name: "pace",
                label: "Your pace",
                type: "select",
                options: [
                  { value: "Slow", label: "Slow: one or two things a day, long lunches" },
                  { value: "Balanced", label: "Balanced: see a lot, still breathe" },
                  { value: "Full", label: "Full: we want to see everything" },
                ],
              },
              {
                name: "budget",
                label: "Daily budget per person, besides the hotel",
                type: "select",
                options: [
                  { value: "Under €100", label: "Under €100" },
                  { value: "€100 to €250", label: "€100 to €250" },
                  { value: "€250 to €500", label: "€250 to €500" },
                  { value: "Over €500", label: "Over €500" },
                ],
              },
              {
                name: "message",
                label: "What would make this trip perfect?",
                type: "textarea",
                required: true,
                help: "What you love, what to avoid, food, where you are staying, anything already booked.",
              },
            ]}
          />
        </div>
      </div>
    </section>

    <footer class="bs-foot wrap">
      <span>© RomeSoMuch</span>
      <a href="/legal/privacy/">Privacy</a>
      <a href="/legal/terms/">Terms</a>
    </footer>
  </div>
</Base>

<script>
  // One story per view; dots, arrows and the progress bar follow the scroll position.
  const track = document.querySelector<HTMLElement>("[data-track]");
  if (track) {
    const slides = track.children.length;
    const dots = [...document.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const bar = document.querySelector<HTMLElement>("[data-bar]");
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (n: number) => track.scrollTo({ left: ((n + slides) % slides) * track.clientWidth, behavior: "smooth" });
    const paint = () => {
      const n = current();
      dots.forEach((d, i) => d.toggleAttribute("aria-current", i === n));
      if (bar) bar.style.width = `${((n + 1) / slides) * 100}%`;
    };
    dots.forEach((d, i) => d.addEventListener("click", () => go(i)));
    document.querySelector("[data-prev]")?.addEventListener("click", () => go(current() - 1));
    document.querySelector("[data-next]")?.addEventListener("click", () => go(current() + 1));
    track.addEventListener("scroll", paint, { passive: true });
    paint();
  }
</script>

<style>
  /* Sizes and spacing measured from hirewinning.com at 1440px and 390px wide. */
  .bs{
    --n:#1d2735; --n2:#4a5566; --line:#e7e9ee; --soft:#f6f5f2;
    --g1:#c4492a; --g2:#e39a2d; --grad:linear-gradient(90deg,var(--g1),var(--g2));
    color:var(--n); font-family:"Plus Jakarta Sans",system-ui,sans-serif; font-size:16px; line-height:1.4;
    background:#fff; position:relative; overflow-x:clip;
  }
  /* Soft colour clouds behind the first screen, like the reference's hero texture. */
  .bs::before{
    content:""; position:absolute; inset:0 0 auto; height:1150px; z-index:0; pointer-events:none;
    background:
      radial-gradient(34% 30% at 4% 42%,rgba(240,168,120,.55),transparent 70%),
      radial-gradient(26% 24% at 16% 78%,rgba(183,198,194,.55),transparent 70%),
      radial-gradient(30% 28% at 96% 30%,rgba(245,205,140,.6),transparent 70%),
      radial-gradient(26% 26% at 86% 74%,rgba(226,150,130,.42),transparent 70%),
      radial-gradient(40% 20% at 50% 0%,rgba(248,228,205,.6),transparent 75%);
    filter:blur(40px);
  }
  .bs>*{position:relative;z-index:1}
  .bs .wrap{width:min(92%,1380px);max-width:none;margin-inline:auto;padding-inline:0}
  /* Same pairing as the main site: Anton for display, Plus Jakarta Sans for text. */
  .bs h1,.bs h2,.bs h3{font-family:var(--disp);font-weight:400;text-transform:uppercase;letter-spacing:.005em;color:var(--n);text-wrap:balance}
  .bs h2{font-size:50px;line-height:1.05}
  .bs h3{font-size:18px;line-height:1.15;letter-spacing:.01em}
  .grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  .center{text-align:center;margin-inline:auto}

  .bs-btn{display:inline-flex;align-items:center;gap:10px;padding:18px 28px;border-radius:100px;background:var(--n);color:#fff;font-family:var(--disp);font-weight:400;font-size:16px;line-height:1.4;letter-spacing:.04em;text-transform:uppercase;border:1.5px solid var(--n);transition:var(--dur) var(--ease)}
  .bs-btn:hover{transform:translateY(-2px);box-shadow:0 16px 30px -14px rgba(29,39,53,.6)}
  .bs-btn.ghost{background:transparent;color:var(--n);border-color:#cfd3db}
  .bs-btn.sm{padding:18px 28px}

  .bs-nav{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-block:20px}
  .bs-logo img{display:block;width:140px;height:auto}
  .bs-links{display:flex;gap:40px;font-size:16px}
  .bs-links a:hover{color:var(--g1)}

  .bs-hero{text-align:center;padding-top:60px}
  .bs-pill{display:inline-flex;align-items:center;gap:12px;padding:8px 18px 8px 13px;border:1px solid var(--line);border-radius:100px;background:rgba(255,255,255,.8);font-size:16px;font-weight:500}
  .bs-pill b{font-weight:600;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
