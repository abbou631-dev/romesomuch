---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import FilterBar from "../../components/FilterBar.astro";
import { categories } from "../../lib/site";

export const getStaticPaths = (async () =>
  categories.map((c) => ({ params: { category: c.slug }, props: { category: c } }))) satisfies GetStaticPaths;

const { category } = Astro.props;
const all = (await getCollection("experiences")).sort((a, b) => a.data.order - b.data.order);
const items = category.slug === "all" ? all : all.filter((e) => e.data.category === category.slug);
---
<Base title={`${category.name} in Rome — RomeSoMuch`} description={category.blurb} active={category.slug}>
  <section class="band">
    <div class="wrap">
      <p class="crumb">Home / Experiences / {category.name}</p>
      <h1>{category.name}</h1>
      <p class="lede">{category.blurb}</p>
    </div>
  </section>
  <div class="wrap">
    <FilterBar slug={category.slug} />
    <div class="grid" id="grid">{items.map((exp) => <Card exp={exp} />)}</div>
    <p id="count" style="margin:24px 0 0;font-size:12.5px;color:var(--muted);font-weight:500"></p>
  </div>
</Base>
