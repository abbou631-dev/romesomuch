---
import Base from "../layouts/Base.astro";
import { contactEmail, whatsapp } from "../lib/site";
---
<Base title="Contact — RomeSoMuch" description="Email or WhatsApp, answered within 48 hours.">
  <section class="band">
    <div class="wrap"><p class="crumb">Home / Contact</p><h1>Contact</h1>
      <p class="lede">Write to us and we answer within 48 hours, usually the same day.</p></div>
  </section>
  <div class="wrap">
    <article class="legal">
      <section class="lsec">
        <h2><span class="tnum">01</span> Email</h2>
        <p>
          Questions about an experience, a group booking, a date that is not on the calendar —
          whatever it is, one address.
        </p>
        <p style="margin-top:18px">
          <a class="btn" href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </p>
      </section>
      <section class="lsec">
        <h2><span class="tnum">02</span> WhatsApp</h2>
        <p>
          Quicker for a short question. We have no fixed hours — we read everything and answer
          within 48 hours, usually the same day.
        </p>
        <p style="margin-top:18px">
          <a class="btn ghost" href={`https://wa.me/${whatsapp.replace(/\D/g, "")}`}>{whatsapp}</a>
        </p>
      </section>
      <section class="lsec">
        <h2><span class="tnum">03</span> Already booked?</h2>
        <p>
          Bookings run through the calendar on each experience page, and your confirmation email
          carries the meeting point and the cancellation terms. To change or cancel a booking,
          reply to that confirmation — it reaches the right place faster than writing here.
        </p>
      </section>
    </article>
  </div>
</Base>
