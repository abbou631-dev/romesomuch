---
import Base from "../layouts/Base.astro";
import { contactEmail } from "../lib/site";
---
<Base title="Contact — RomeSoMuch">
  <section class="band">
    <div class="wrap"><p class="crumb">Home / Contact</p><h1>Contact</h1>
      <p class="lede">Write to us and we answer the same day.</p></div>
  </section>
  <div class="wrap">
    <article class="legal">
      <section class="lsec">
        <h2><span class="tnum">01</span> Email</h2>
        <p>
          Questions about an experience, a group booking, a date that is not on the calendar —
          whatever it is, one address.
        </p>
        <p style="margin-top:18px">
          <a class="btn" href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </p>
      </section>
      <section class="lsec">
        <h2><span class="tnum">02</span> Already booked?</h2>
        <p>
          Bookings run through the calendar on each experience page, and your confirmation email
          carries the meeting point and the cancellation terms. To change or cancel a booking,
          reply to that confirmation — it reaches the right place faster than writing here.
        </p>
      </section>
      <div class="ph" style="margin:24px 0;max-width:70ch">
        <span class="k">Contenuto da inserire</span>
        <span class="d">
          WhatsApp e orari di risposta: da fornire. Finché non ci sono numeri reali, questa pagina
          offre solo l'email.
        </span>
      </div>
    </article>
  </div>
</Base>
