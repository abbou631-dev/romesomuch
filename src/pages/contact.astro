---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import { categoryName, whatsapp } from "../lib/site";

// A free text box asking "what is it about" gets skipped, and the message that
// arrives could be about any of twenty one experiences. Picking from a list
// costs the sender one tap and tells us exactly what to answer.
const reasons = [
  { value: "Booking an experience", label: "Booking an experience" },
  { value: "A date that is not on the calendar", label: "A date that is not on the calendar" },
  { value: "A private or group booking", label: "A private or group booking" },
  { value: "An existing booking", label: "An existing booking" },
  { value: "Something else", label: "Something else" },
];

const experiences = (await getCollection("experiences"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((exp) => ({
    // The value is what lands in the subject line, so it stays clean; the
    // category rides along in the label, where it helps the sender find the row.
    value: exp.data.title,
    label: `${exp.data.title} (${categoryName(exp.data.category)})`,
  }));
---
<Base title="Contact — RomeSoMuch" description="Email or WhatsApp, answered within 48 hours.">
  <section class="band">
    <div class="wrap"><p class="crumb">Home / Contact</p><h1>Contact</h1>
      <p class="lede">Write to us and we answer within 48 hours, usually the same day.</p></div>
  </section>
  <div class="wrap">
    <article class="legal">
      <section class="lsec">
        <h2><span class="tnum">01</span> Write to us</h2>
        <p>
          Questions about an experience, a group booking, a date that is not on the calendar —
          whatever it is, it lands in the same inbox.
        </p>
        <EnquiryForm
          kind="contact"
          submit="Send message"
          fields={[
            { name: "name", label: "Name", required: true },
            { name: "email", label: "Email", type: "email", required: true, help: "So we can answer you." },
            {
              name: "topic",
              label: "What is it about",
              type: "select",
              required: true,
              options: reasons,
              placeholder: "Pick the closest one",
            },
            {
              name: "experience",
              label: "Which experience",
              type: "select",
              options: experiences,
              placeholder: "Not about a particular one",
              help: "Leave this if your message is not about a specific experience.",
            },
            { name: "message", label: "Message", type: "textarea", required: true },
          ]}
        />
      </section>
      <section class="lsec">
        <h2><span class="tnum">02</span> WhatsApp</h2>
        <p>
          Quicker for a short question. We have no fixed hours — we read everything and answer
          within 48 hours, usually the same day.
        </p>
        <p style="margin-top:18px">
          <a class="btn ghost" href={`https://wa.me/${whatsapp.replace(/\D/g, "")}`}>{whatsapp}</a>
        </p>
      </section>
      <section class="lsec">
        <h2><span class="tnum">03</span> Already booked?</h2>
        <p>
          Bookings run through the calendar on each experience page, and your confirmation email
          carries the meeting point and the cancellation terms. To change or cancel a booking,
          reply to that confirmation — it reaches the right place faster than writing here.
        </p>
      </section>
    </article>
  </div>
</Base>
