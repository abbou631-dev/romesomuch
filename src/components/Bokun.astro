---
import EnquiryForm from "./EnquiryForm.astro";
import { bokunChannel } from "../lib/site";

interface Props {
  productId: string | null;
  embed?: string | null;
  policy: string;
  price: number;
  unit: "person" | "group";
  durationLabel: string;
  title: string;
}
const { productId, embed = null, policy, price, unit, durationLabel, title } = Astro.props;

// Two ways to wire an experience to Bokun, in order of precedence:
// 1. the embed snippet pasted in the CMS, which carries its own channel UUID;
// 2. a product id plus PUBLIC_BOKUN_CHANNEL from the environment.
const pasted = embed?.trim() ?? "";
// Scripts injected through set:html never execute, so the loader is added below
// with the channel read out of the snippet.
const markup = pasted.replace(/<script[\s\S]*?<\/script>/gi, "").trim();
const channel = bokunChannel(pasted);
const src = channel && productId
  ? `https://widgets.bokun.io/online-sales/${channel}/experience-calendar/${productId}`
  : "";
// Until Bokun carries this experience the page takes a request instead. It must
// not claim instant confirmation it cannot deliver.
const live = Boolean(channel) && Boolean(markup || src);

// Asking for today is pointless on a request that takes up to 48 hours to answer.
const tomorrow = new Date(Date.now() + 86400000).toISOString().slice(0, 10);
---
<div class="book" id="bokunBox">
  {live ? (
    <>
      <span class="badge-live">Live availability</span>
      <h3 style="margin-top:10px">Book instantly</h3>
      <p class="fine" style="margin-top:4px">€{price} per {unit} · {durationLabel} · confirmed straight away</p>
      {markup ? <div class="bokunEmbed" set:html={markup} /> : <div class="bokunWidget" id="bokunSlot" data-src={src}></div>}
    </>
  ) : (
    <>
      <span class="badge">On request</span>
      <h3 style="margin-top:10px">Ask for a date</h3>
      <p class="fine" style="margin-top:4px">€{price} per {unit} · {durationLabel} · we answer within 48 hours</p>
      <EnquiryForm
        kind="booking"
        submit="Send request"
        hidden={{ experience: title }}
        fields={[
          { name: "name", label: "Name", required: true },
          { name: "email", label: "Email", type: "email", required: true },
          { name: "date", label: "Preferred date", type: "date", min: tomorrow, weekendsOnly: true, help: "Saturdays and Sundays only." },
          { name: "guests", label: "How many of you" },
          { name: "message", label: "Anything we should know", type: "textarea" },
        ]}
      />
    </>
  )}
  <p class="fine">{policy}</p>
</div>

{live && (
  <script is:inline define:vars={{ channel }}>
    if (!document.getElementById("bokunLoader")) {
      const s = document.createElement("script");
      s.id = "bokunLoader";
      s.async = true;
      s.src = `https://widgets.bokun.io/assets/javascripts/apps/build/BokunWidgetsLoader.js?bookingChannelUUID=${channel}`;
      document.head.appendChild(s);
    }
  </script>
)}
