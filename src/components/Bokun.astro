---
interface Props { productId: string | null; price: number; unit: "person" | "group"; durationLabel: string }
const { productId, price, unit, durationLabel } = Astro.props;
const channel = import.meta.env.PUBLIC_BOKUN_CHANNEL ?? "";
const ready = Boolean(channel && productId);
const src = ready ? `https://widgets.bokun.io/online-sales/${channel}/experience/${productId}` : "";
const missing = !channel
  ? "Manca PUBLIC_BOKUN_CHANNEL in .env: aggiungi il booking channel UUID e il calendario compare qui."
  : "Manca bokunProductId nel frontmatter di questa esperienza: aggiungi l'id prodotto Bokun e il calendario compare qui.";
---
<div class="book" id="bokunBox">
  <span class="badge-live">Live availability</span>
  <h3 style="margin-top:10px">Book instantly</h3>
  <p class="fine" style="margin-top:4px">€{price} per {unit} · {durationLabel} · confirmed straight away</p>
  <div class="bokunWidget" id="bokunSlot" data-src={src}></div>
  {!ready && (
    <div class="ph" style="margin-top:14px">
      <span class="k">Calendario Bokun</span>
      <span class="d">{missing}</span>
    </div>
  )}
  <p class="fine">
    Free cancellation up to 48 hours before the start time.
  </p>
</div>

{ready && (
  <script is:inline define:vars={{ channel }}>
    if (!document.getElementById("bokunLoader")) {
      const s = document.createElement("script");
      s.id = "bokunLoader";
      s.async = true;
      s.src = `https://widgets.bokun.io/assets/javascripts/apps/build/BokunWidgetsLoader.js?bookingChannelUUID=${channel}`;
      document.head.appendChild(s);
    }
  </script>
)}
