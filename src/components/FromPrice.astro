---
/**
 * Live "Starting from €X / person" for the golf cart tours: the lowest price
 * one guest pays on any day of the coming year. Prices change with the
 * partner's list and our commission rules, so the number is read at runtime
 * from /api/golfcart-from (functions/api/golfcart-from.js) and never written
 * into the content.
 *
 * Renders the same spans as a card's price line (f / v / u), so it takes the
 * styling of wherever it sits. Once the price arrives, the nearest
 * [data-price] ancestor (a card) gets the number too, which keeps the price
 * filters and the price sort working on listing pages.
 *
 * Usage:  <FromPrice tour="vip" />
 */
interface Props { tour: "vip" | "night" | "oneday"; fallback?: string }
const { tour, fallback = "Check availability" } = Astro.props;
---
<span class="golfcart-from" data-golfcart-from={tour}><span class="f">{fallback}</span></span>

<script is:inline>
  (function () {
    if (window.__golfcartFrom) return; window.__golfcartFrom = 1;
    function run() {
      var els = Array.prototype.slice.call(document.querySelectorAll("[data-golfcart-from]"));
      if (!els.length) return;
      var tours = els.map(function (el) { return el.getAttribute("data-golfcart-from"); })
        .filter(function (t, i, all) { return all.indexOf(t) === i; });
      Promise.all(tours.map(function (t) {
        return fetch("/api/golfcart-from?tour=" + encodeURIComponent(t))
          .then(function (r) { return r.ok ? r.json() : null; })
          .catch(function () { return null; });
      })).then(function (answers) {
        var by = {};
        answers.forEach(function (a) { if (a && a.from) by[a.tour] = Number(a.from); });
        els.forEach(function (el) {
          var n = by[el.getAttribute("data-golfcart-from")];
          if (!n) return; // the fallback text stays
          el.innerHTML = '<span class="f">Starting from</span> <span class="v tnum">€' + n + '</span> <span class="u">/ person</span>';
          var card = el.closest("[data-price]");
          if (card) card.setAttribute("data-price", String(n));
        });
        document.dispatchEvent(new CustomEvent("golfcart:prices"));
      });
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", run); else run();
  })();
</script>
