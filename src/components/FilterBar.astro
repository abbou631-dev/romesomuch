---
import { bandsFor } from "../lib/site";

interface Props { slug: string; prices: number[]; durations: number[] }
const { slug, prices, durations } = Astro.props;

// A group is only worth showing when it can actually split the page in two.
const groups = (
  [
    ["price", "Price", bandsFor(prices, "price")],
    ["length", "Length", bandsFor(durations, "length")],
  ] as const
).filter(([, , bands]) => bands.length > 1);
---
<div class="filters" data-slug={slug}>
  <div style="display:flex;gap:16px;flex-wrap:wrap">
    {groups.map(([key, label, bands]) => (
      <div class="fgroup">
        <span class="lbl">{label}</span>
        <button class="chip on" data-filter={key} data-min="0" data-max="Infinity">Any</button>
        {bands.map((b) => (
          <button class="chip" data-filter={key} data-min={b.min} data-max={b.max}>{b.label}</button>
        ))}
      </div>
    ))}
  </div>
  <label class="sortwrap">
    <span class="lbl">Sort</span>
    <span class="sortval" id="sortval">Curated</span>
    <select class="sort" id="sort" aria-label="Sort experiences">
      <option value="curated">Curated</option>
      <option value="px-asc">Price, low to high</option>
      <option value="px-desc">Price, high to low</option>
      <option value="dur">Shortest first</option>
    </select>
  </label>
</div>

<script>
  const grid = document.getElementById("grid");
  if (grid) {
    const cards = Array.from(grid.children) as HTMLElement[];
    const order = new Map(cards.map((c, i) => [c, i]));
    const count = document.getElementById("count")!;
    const field = { price: "price", length: "duration" } as const;
    type Group = keyof typeof field;
    const state: Record<Group, [number, number]> = {
      price: [0, Infinity],
      length: [0, Infinity],
    };
    const sort = { by: "curated" };

    const keep = (card: HTMLElement) =>
      (Object.keys(state) as Group[]).every((g) => {
        const v = Number(card.dataset[field[g]]);
        return v >= state[g][0] && v <= state[g][1];
      });

    const apply = () => {
      const visible: HTMLElement[] = [];
      for (const card of cards) {
        const ok = keep(card);
        card.hidden = !ok;
        if (ok) visible.push(card);
      }
      visible.sort((a, b) => {
        const pa = Number(a.dataset.price), pb = Number(b.dataset.price);
        if (sort.by === "px-asc") return pa - pb;
        if (sort.by === "px-desc") return pb - pa;
        if (sort.by === "dur") return Number(a.dataset.duration) - Number(b.dataset.duration);
        return order.get(a)! - order.get(b)!;
      });
      visible.forEach((card) => grid.appendChild(card));
      const n = visible.length;
      count.textContent = `${n} experience${n === 1 ? "" : "s"} shown.`;
    };

    document.querySelectorAll<HTMLButtonElement>(".chip[data-filter]").forEach((chip) => {
      chip.addEventListener("click", () => {
        const group = chip.dataset.filter as Group;
        state[group] = [Number(chip.dataset.min), Number(chip.dataset.max)];
        document
          .querySelectorAll(`.chip[data-filter="${group}"]`)
          .forEach((c) => c.classList.toggle("on", c === chip));
        apply();
      });
    });
    const sortSel = document.getElementById("sort") as HTMLSelectElement;
    const sortVal = document.getElementById("sortval")!;
    sortSel.addEventListener("change", () => {
      sort.by = sortSel.value;
      sortVal.textContent = sortSel.options[sortSel.selectedIndex].text;
      apply();
    });
    apply();
  }
</script>
