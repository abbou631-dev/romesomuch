---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { categories } from "../lib/site";

interface Props { active?: string }
const { active = "" } = Astro.props;
---
<header>
  <div class="bar">
    <a class="logo" href="/"><Image src={logo} alt="RomeSoMuch" width={220} densities={[1, 2]} loading="eager" /></a>
    <div class="navstrip">
      <div class="catwrap" id="cat-wrap">
        <button class="catbtn" type="button" id="cat-toggle" aria-expanded="false" aria-controls="cat-list">
          <span class="grid4" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span>Categories</span>
        </button>
        <nav class="cats" id="cat-list" aria-label="Categories">
          {categories.map((c) => (
            <a
              href={`/experiences/${c.slug}/`}
              class={active === c.slug ? "on" : ""}
              aria-current={active === c.slug ? "page" : undefined}
            >{c.name}</a>
          ))}
        </nav>
      </div>
      <nav class="sec">
        <a href="/journal/">Journal</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a class="cta" href="/experiences/all/">All experiences</a>
      </nav>
    </div>
  </div>
</header>

<script>
  const wrap = document.getElementById("cat-wrap");
  const btn = document.getElementById("cat-toggle");
  if (wrap && btn) {
    const setOpen = (open: boolean) => {
      wrap.classList.toggle("open", open);
      btn.setAttribute("aria-expanded", String(open));
    };
    btn.addEventListener("click", (ev) => {
      ev.stopPropagation();
      setOpen(!wrap.classList.contains("open"));
    });
    document.addEventListener("click", (ev) => {
      if (!wrap.contains(ev.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && wrap.classList.contains("open")) {
        setOpen(false);
        btn.focus();
      }
    });
  }
</script>
