---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import logo from "../assets/logo.png";
import Search from "./Search.astro";
import { liveCategories } from "../lib/site";

interface Props { active?: string }
const { active = "" } = Astro.props;
const all = (await getCollection("experiences")).sort((a, b) => a.data.order - b.data.order);
const categories = liveCategories(all.map((e) => e.data.category));
---
<header class="site">
  <div class="bar">
    <a class="logo" href="/"><Image src={logo} alt="RomeSoMuch" width={220} densities={[1, 2]} loading="eager" /></a>
    <div class="navstrip">
      <div class="catwrap" id="cat-wrap">
        <button class="catbtn" type="button" id="cat-toggle" aria-expanded="false" aria-controls="cat-list">
          <span class="grid4" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span>Categories</span>
        </button>
        <nav class="cats" id="cat-list" aria-label="Categories">
          {categories.map((c) => (
            <a
              href={`/experiences/${c.slug}/`}
              class={active === c.slug ? "on" : ""}
              aria-current={active === c.slug ? "page" : undefined}
            >{c.name}</a>
          ))}
        </nav>
      </div>
      <button class="searchbtn" type="button" id="search-toggle" aria-expanded="false" aria-controls="search-panel" aria-label="Search experiences">
        <span aria-hidden="true">🔍</span>
      </button>
      <nav class="sec">
        <a href="/journal/">Journal</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a class="cta" href="/experiences/all/">All experiences</a>
      </nav>
    </div>
  </div>
  <!-- Phone only: the hero is hidden there, so this is where the search lives. -->
  <div class="search-panel" id="search-panel" hidden>
    <div class="wrap"><Search items={all} id="qm" /></div>
  </div>
</header>

<script>
  const panel = document.getElementById("search-panel");
  const toggle = document.getElementById("search-toggle");
  if (panel && toggle) {
    const open = (on: boolean) => {
      panel.hidden = !on;
      toggle.setAttribute("aria-expanded", String(on));
      if (on) panel.querySelector<HTMLInputElement>("input[type=search]")?.focus();
    };
    toggle.addEventListener("click", (ev) => {
      ev.stopPropagation();
      open(panel.hidden);
    });
    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && !panel.hidden) {
        open(false);
        toggle.focus();
      }
    });
    document.addEventListener("click", (ev) => {
      const target = ev.target as Node;
      if (!panel.hidden && !panel.contains(target) && target !== toggle) open(false);
    });
  }

  const wrap = document.getElementById("cat-wrap");
  const btn = document.getElementById("cat-toggle");
  if (wrap && btn) {
    const setOpen = (open: boolean) => {
      wrap.classList.toggle("open", open);
      btn.setAttribute("aria-expanded", String(open));
    };
    btn.addEventListener("click", (ev) => {
      ev.stopPropagation();
      setOpen(!wrap.classList.contains("open"));
    });
    document.addEventListener("click", (ev) => {
      if (!wrap.contains(ev.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && wrap.classList.contains("open")) {
        setOpen(false);
        btn.focus();
      }
    });
  }
</script>
