---
import { getCollection } from "astro:content";
import logo from "../assets/logo.svg";
import Search from "./Search.astro";
import { liveCategories, newestFirst } from "../lib/site";

interface Props { active?: string }
const { active = "" } = Astro.props;
const all = (await getCollection("experiences")).sort((a, b) => a.data.order - b.data.order);
const categories = liveCategories(all.map((e) => e.data.category));
// Phone/tablet only: the Journal pill opens the latest articles.
const latest = newestFirst(await getCollection("journal")).slice(0, 5);
---
<header class="site">
  <div class="bar">
    <a class="logo" href="/"><img src={logo.src} alt="RomeSoMuch" width={220} height={Math.round(220 * logo.height / logo.width)} loading="eager" /></a>
    <div class="navstrip">
      <div class="catwrap" id="cat-wrap">
        <button class="catbtn" type="button" id="cat-toggle" aria-expanded="false" aria-controls="cat-list">
          <span class="grid4" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span>Experiences</span>
        </button>
        <nav class="cats" id="cat-list" aria-label="Categories">
          {categories.map((c) => (
            <a
              href={`/experiences/${c.slug}/`}
              class={active === c.slug ? "on" : ""}
              aria-current={active === c.slug ? "page" : undefined}
            >{c.name}</a>
          ))}
        </nav>
      </div>
      <div class="catwrap jwrap" id="journal-wrap">
        <button class="catbtn" type="button" id="journal-toggle" aria-expanded="false" aria-controls="journal-list">
          <span>Journal</span>
        </button>
        <nav class="cats" id="journal-list" aria-label="Journal">
          {latest.map((p) => <a href={`/journal/${p.id}/`}>{p.data.title}</a>)}
          <a class="all" href="/journal/">All articles →</a>
        </nav>
      </div>
      <button class="searchbtn" type="button" id="search-toggle" aria-expanded="false" aria-controls="search-panel" aria-label="Search experiences">
        <span aria-hidden="true">🔍</span>
      </button>
      <div class="menuwrap" id="menu-wrap">
      <button class="menubtn" type="button" id="menu-toggle" aria-expanded="false" aria-controls="menu-list" aria-label="Menu">
        <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
      <nav class="sec" id="menu-list" aria-label="Menu">
        <a href="/gift-cards/">Gift cards</a>
        <a class="jl" href="/journal/">Journal</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a class="cta" href="/experiences/all/">All experiences</a>
      </nav>
      </div>
    </div>
  </div>
  <!-- Phone only: the hero is hidden there, so this is where the search lives. -->
  <div class="search-panel" id="search-panel" hidden>
    <div class="wrap"><Search items={all} id="qm" /></div>
  </div>
</header>

<script>
  const panel = document.getElementById("search-panel");
  const toggle = document.getElementById("search-toggle");
  if (panel && toggle) {
    const open = (on: boolean) => {
      panel.hidden = !on;
      toggle.setAttribute("aria-expanded", String(on));
      if (on) panel.querySelector<HTMLInputElement>("input[type=search]")?.focus();
    };
    toggle.addEventListener("click", (ev) => {
      ev.stopPropagation();
      open(panel.hidden);
    });
    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && !panel.hidden) {
        open(false);
        toggle.focus();
      }
    });
    document.addEventListener("click", (ev) => {
      const target = ev.target as Node;
      if (!panel.hidden && !panel.contains(target) && target !== toggle) open(false);
    });
  }

  // Experiences, Journal and, on phones, the menu: same open/close behaviour.
  for (const [w, b] of [["cat-wrap", "cat-toggle"], ["journal-wrap", "journal-toggle"], ["menu-wrap", "menu-toggle"]]) {
    const wrap = document.getElementById(w);
    const btn = document.getElementById(b);
    if (!wrap || !btn) continue;
    const setOpen = (open: boolean) => {
      wrap.classList.toggle("open", open);
      btn.setAttribute("aria-expanded", String(open));
    };
    btn.addEventListener("click", (ev) => {
      ev.stopPropagation();
      setOpen(!wrap.classList.contains("open"));
    });
    document.addEventListener("click", (ev) => {
      if (!wrap.contains(ev.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && wrap.classList.contains("open")) {
        setOpen(false);
        btn.focus();
      }
    });
  }
</script>
