---
/**
 * Booking request box for the tours we arrange ourselves (no online payment).
 * Same look as the golf cart box: one centred column, Anton headings, cream
 * highlight. The visitor picks guests, a date and a time of day, leaves a
 * WhatsApp number (or an email), and the request goes to /api/enquiry
 * (kind "tour"), which emails it to us. We answer on WhatsApp.
 */
interface Props { experience: string; maxGuests?: number | null }
const { experience, maxGuests = null } = Astro.props;
const cap = maxGuests ?? 20;
// Country codes, most frequent visitors first.
const codes: [string, string][] = [
  ["+1", "US/CA"], ["+44", "UK"], ["+39", "IT"], ["+61", "AU"], ["+353", "IE"], ["+49", "DE"], ["+33", "FR"],
  ["+34", "ES"], ["+31", "NL"], ["+41", "CH"], ["+43", "AT"], ["+32", "BE"], ["+351", "PT"], ["+46", "SE"],
  ["+47", "NO"], ["+45", "DK"], ["+48", "PL"], ["+55", "BR"], ["+52", "MX"], ["+54", "AR"], ["+57", "CO"],
  ["+64", "NZ"], ["+27", "ZA"], ["+971", "AE"], ["+972", "IL"], ["+91", "IN"], ["+65", "SG"], ["+81", "JP"],
  ["+82", "KR"], ["+86", "CN"],
];
---
<div class="rq" data-rq data-cap={cap}>
  <form class="rq-card" action="/api/enquiry" method="post" novalidate>
    <input type="hidden" name="kind" value="tour" />
    <input type="hidden" name="experience" value={experience} />
    <input type="hidden" name="date" value="" />
    <input type="hidden" name="time" value="" />
    <input type="hidden" name="guests" value="2" />
    <input type="hidden" name="whatsapp" value="" />
    <input type="hidden" name="page" value="" />
    <input type="hidden" name="lastViewed" value="" />
    <label class="rq-trap" aria-hidden="true">Leave this empty<input type="text" name="website_url" tabindex="-1" autocomplete="off" /></label>

    <section class="rq-sec">
      <h3>Guests<small>1–{cap} guests · all ages</small></h3>
      <div class="rq-step">
        <button type="button" data-g="-1" aria-label="One guest fewer">–</button>
        <output aria-live="polite">2</output>
        <button type="button" data-g="1" aria-label="One more guest">+</button>
      </div>
      <p class="rq-hint">Private tour, just your group</p>
    </section>

    <section class="rq-sec">
      <h3>Choose a date</h3>
      <div class="rq-cal">
        <div class="rq-hd">
          <button type="button" data-m="-1" aria-label="Previous month">‹</button>
          <b aria-live="polite"></b>
          <button type="button" data-m="1" aria-label="Next month">›</button>
        </div>
        <div class="rq-grid" role="grid"></div>
      </div>
    </section>

    <section class="rq-sec">
      <h3>Time of day</h3>
      <div class="rq-slots" role="group" aria-label="Preferred time of day">
        <button type="button" data-t="Morning">Morning</button>
        <button type="button" data-t="Afternoon">Afternoon</button>
        <button type="button" data-t="Flexible" class="on">Flexible</button>
      </div>
      <p class="rq-hint">We confirm the exact start time with you</p>
    </section>

    <section class="rq-sec rq-f">
      <h3>Your details</h3>
      <div class="rq-field"><label for="rqName">Name</label><input id="rqName" name="name" autocomplete="name" required /></div>
      <div class="rq-field">
        <label for="rqTel">WhatsApp <em>· best way to reach you</em></label>
        <div class="rq-tel">
          <select id="rqCc" aria-label="Country code">{codes.map(([c, n]) => <option value={c}>{c} {n}</option>)}</select>
          <input id="rqTel" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="Phone number" />
        </div>
      </div>
      <div class="rq-field"><label for="rqMail">Email <em id="rqMailHint">· if you don't use WhatsApp</em></label><input id="rqMail" name="email" type="email" autocomplete="email" /></div>
      <div class="rq-field"><label for="rqNote">Notes (optional)</label><textarea id="rqNote" name="message" rows="2" placeholder="Interests, children, accessibility, your hotel"></textarea></div>
    </section>

    <div class="rq-sum" hidden>
      <p class="rq-lbl">Your request</p>
      <p class="rq-item">{experience}</p>
      <p class="rq-meta"></p>
    </div>

    <button class="rq-btn" type="submit" disabled>Choose a date</button>
    <p class="rq-err" role="alert" hidden></p>
    <p class="rq-fine">No payment now. We check availability and message you on WhatsApp with the price and the details.</p>
  </form>

  <div class="rq-done" hidden>
    <p class="rq-kick">Request received</p>
    <h3>We'll be in <span class="hl">touch</span></h3>
    <p class="rq-sub"></p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-rq]").forEach((root) => {
    const form = root.querySelector("form")!;
    const cap = Number(root.dataset.cap) || 20;
    const $ = <T extends Element>(s: string) => root.querySelector(s) as T;
    const hidden = (name: string) => form.querySelector(`input[name=${name}]`) as HTMLInputElement;
    const btn = $<HTMLButtonElement>(".rq-btn");
    const grid = $<HTMLElement>(".rq-grid");
    const title = $<HTMLElement>(".rq-hd b");
    const prev = $<HTMLButtonElement>('[data-m="-1"]');
    const err = $<HTMLElement>(".rq-err");
    const name = $<HTMLInputElement>("#rqName");
    const cc = $<HTMLSelectElement>("#rqCc");
    const tel = $<HTMLInputElement>("#rqTel");
    const mail = $<HTMLInputElement>("#rqMail");

    const pad = (n: number) => String(n).padStart(2, "0");
    const iso = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const today = new Date(); today.setHours(0, 0, 0, 0);
    // Same-day requests cannot be arranged; the first bookable day is tomorrow.
    const first = new Date(today); first.setDate(first.getDate() + 1);
    const state = { guests: 2, date: "", time: "Flexible", month: new Date(first.getFullYear(), first.getMonth(), 1) };

    // Guess the visitor's country code from the browser language, for convenience only.
    try {
      const region = (navigator.language.split("-")[1] || "").toUpperCase();
      const match = Array.from(cc.options).find((o) => o.text.includes(region) && region);
      if (match) cc.value = match.value;
    } catch { /* keeps +1 */ }

    const phone = () => tel.value.replace(/[^\d]/g, "");
    const okPhone = () => phone().length >= 6;
    const okMail = () => /^[^@\s]+@[^@\s.]+\.[^@\s]+$/.test(mail.value.trim());
    const valid = () => state.date && name.value.trim().length > 1 && (okPhone() || okMail()) && (!mail.value.trim() || okMail());

    const nice = (s: string) => new Date(`${s}T12:00`).toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short", year: "numeric" });

    function sync() {
      hidden("guests").value = String(state.guests);
      hidden("date").value = state.date;
      hidden("time").value = state.time;
      hidden("whatsapp").value = okPhone() ? `${cc.value} ${tel.value.trim()}` : "";
      $<HTMLElement>(".rq-step output").textContent = String(state.guests);
      $<HTMLButtonElement>('[data-g="-1"]').disabled = state.guests <= 1;
      $<HTMLButtonElement>('[data-g="1"]').disabled = state.guests >= cap;
      $<HTMLElement>("#rqMailHint").textContent = okPhone() ? "· optional" : "· if you don't use WhatsApp";
      const sum = $<HTMLElement>(".rq-sum");
      sum.hidden = !state.date;
      if (state.date) {
        $<HTMLElement>(".rq-meta").textContent =
          `${nice(state.date)} · ${state.time} · ${state.guests} guest${state.guests === 1 ? "" : "s"}`;
      }
      if (!state.date) { btn.textContent = "Choose a date"; btn.disabled = true; return; }
      btn.disabled = !valid();
      btn.textContent = valid() ? "Send request" : "Fill in your details";
    }

    function calendar() {
      const m = state.month;
      title.textContent = m.toLocaleDateString("en-GB", { month: "long", year: "numeric" });
      prev.disabled = m.getFullYear() === first.getFullYear() && m.getMonth() === first.getMonth();
      const days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].map((d) => `<span class="rq-dw">${d}</span>`);
      const lead = (new Date(m.getFullYear(), m.getMonth(), 1).getDay() + 6) % 7;
      const count = new Date(m.getFullYear(), m.getMonth() + 1, 0).getDate();
      const cells = Array.from({ length: lead }, () => "<span></span>");
      for (let d = 1; d <= count; d++) {
        const day = new Date(m.getFullYear(), m.getMonth(), d);
        const key = iso(day);
        const cls = [key === state.date && "on", key === iso(today) && "today"].filter(Boolean).join(" ");
        cells.push(`<button type="button" data-d="${key}"${day < first ? " disabled" : ""}${cls ? ` class="${cls}"` : ""} aria-label="${nice(key)}">${d}</button>`);
      }
      grid.innerHTML = days.concat(cells).join("");
    }

    root.addEventListener("click", (e) => {
      const t = (e.target as HTMLElement).closest("button");
      if (!t || t.disabled) return;
      if (t.dataset.g) state.guests = Math.min(cap, Math.max(1, state.guests + Number(t.dataset.g)));
      else if (t.dataset.m) state.month = new Date(state.month.getFullYear(), state.month.getMonth() + Number(t.dataset.m), 1);
      else if (t.dataset.d) state.date = t.dataset.d;
      else if (t.dataset.t) {
        state.time = t.dataset.t;
        root.querySelectorAll<HTMLButtonElement>("[data-t]").forEach((b) => b.classList.toggle("on", b === t));
      } else return;
      calendar(); sync();
    });
    [name, tel, mail, cc].forEach((el) => { el.addEventListener("input", sync); el.addEventListener("change", sync); });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!valid()) return;
      sync();
      hidden("page").value = location.pathname;
      try { hidden("lastViewed").value = sessionStorage.getItem("rsm-last") ?? ""; } catch { /* optional context */ }
      btn.disabled = true; btn.textContent = "Sending…"; err.hidden = true;
      try {
        const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
        const data = await res.json().catch(() => ({ ok: false, message: "Something went wrong. Please try again." }));
        if (!res.ok || !data.ok) throw new Error(data.message);
        const via = okPhone() ? `on WhatsApp at ${cc.value} ${tel.value.trim()}` : `by email at ${mail.value.trim()}`;
        $<HTMLElement>(".rq-sub").textContent =
          `We check availability for ${nice(state.date)} and message you ${via} with the price and the details. Nothing is charged until you confirm.`;
        form.hidden = true;
        $<HTMLElement>(".rq-done").hidden = false;
        (window as any).rsmTrack?.("Lead", { content_name: hidden("experience").value });
        root.scrollIntoView({ behavior: "smooth", block: "start" });
      } catch (error) {
        err.textContent = (error as Error).message || "Something went wrong. Please try again.";
        err.hidden = false;
        sync();
      }
    });

    calendar(); sync();
  });
</script>

<style>
  .rq{--rq-yellow:#f3e7c0;--rq-soft:#f8f4e7;--rq-gold:#b8912f;--rq-edge:#a7b2ba;--rq-hair:rgba(10,10,10,.10);--rq-muted:#5c6560;--rq-err:#b42318;text-align:center;margin-top:16px}
  .rq-card{display:grid;gap:22px;justify-items:center}
  .rq-trap{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
  .rq-sec{width:100%;display:grid;gap:12px;justify-items:center}
  .rq h3{font-family:var(--disp);font-weight:400;line-height:.95;text-transform:uppercase;font-size:28px;margin:0}
  .rq h3 small{display:block;font-family:var(--body);font-size:10px;font-weight:700;letter-spacing:.2em;color:var(--rq-muted);margin-top:8px}
  .rq-hint,.rq-fine{font-size:11.5px;color:var(--rq-muted);line-height:1.5;margin:0}
  .rq-step{display:flex;align-items:center;justify-content:center;gap:18px;border:1px solid var(--rq-hair);border-radius:10px;padding:10px 18px}
  .rq-step button{width:34px;height:34px;border-radius:50%;border:1px solid var(--rq-hair);background:#fff;font-size:18px;line-height:1;cursor:pointer;transition:background .3s cubic-bezier(.4,0,.2,1)}
  .rq-step button:hover:not(:disabled){background:var(--rq-yellow)}
  .rq-step button:disabled{opacity:.3;cursor:default}
  .rq-step output{min-width:30px;font-family:var(--disp);font-size:22px;line-height:1}
  .rq-cal{width:100%;border:1px solid var(--rq-hair);border-radius:16px;padding:14px 10px}
  .rq-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
  .rq-hd b{font-family:var(--disp);font-weight:400;font-size:22px;text-transform:uppercase}
  .rq-hd button{width:40px;height:40px;border-radius:999px;border:1px solid var(--rq-hair);background:#fff;font-size:16px;cursor:pointer}
  .rq-hd button:disabled{opacity:.3;cursor:default}
  .rq-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
  .rq-grid :global(.rq-dw){font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--rq-muted);padding:4px 0}
  .rq-grid :global(button){aspect-ratio:1;max-height:52px;border:1px solid transparent;border-radius:10px;background:transparent;font-size:15px;font-weight:600;color:var(--ink);cursor:pointer;padding:0}
  .rq-grid :global(button:hover:not(:disabled)){background:var(--rq-yellow)}
  .rq-grid :global(button:disabled){color:#c4cbc8;font-weight:500;cursor:default;text-decoration:line-through}
  .rq-grid :global(button.today){border-color:var(--rq-edge)}
  .rq-grid :global(button.on),.rq-grid :global(button.on:hover){background:var(--ink);border-color:var(--ink);color:#fff}
  .rq-slots{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
  .rq-slots button{min-height:44px;border:1px solid var(--rq-edge);background:#fff;border-radius:999px;padding:8px 16px;font-size:15px;font-weight:600;cursor:pointer;transition:background .3s cubic-bezier(.4,0,.2,1)}
  .rq-slots button:hover{background:var(--rq-yellow);border-color:var(--rq-yellow)}
  .rq-slots button.on,.rq-slots button.on:hover{background:var(--ink);border-color:var(--ink);color:#fff}
  .rq-f{gap:15px}
  .rq-field{width:100%;display:grid;gap:7px}
  .rq-field label{font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--rq-muted)}
  .rq-field label em{font-style:normal;letter-spacing:.08em;text-transform:none;font-weight:600;color:var(--rq-gold)}
  .rq-field input,.rq-field textarea,.rq-field select{width:100%;font-family:var(--body);font-size:16px;font-weight:500;color:var(--ink);background:#fff;border:1px solid var(--rq-hair);border-radius:10px;padding:13px 14px;text-align:center;text-align-last:center;outline:none;transition:border-color .3s cubic-bezier(.4,0,.2,1)}
  .rq-field input:focus,.rq-field textarea:focus,.rq-field select:focus{border-color:var(--ink)}
  .rq-tel{display:grid;grid-template-columns:118px minmax(0,1fr);gap:8px}
  .rq-sum{width:100%;background:var(--rq-soft);border:1px solid var(--rq-hair);border-radius:16px;padding:20px 16px;display:grid;gap:6px}
  .rq-lbl{font-size:10px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--rq-muted);margin:0}
  .rq-item{font-size:15px;font-weight:600;margin:0}
  .rq-meta{font-size:14px;color:var(--rq-muted);margin:0}
  .rq-btn{display:inline-flex;align-items:center;justify-content:center;width:100%;min-height:48px;font-family:var(--disp);font-size:17px;letter-spacing:.02em;text-transform:uppercase;background:var(--ink);color:#fff;border:1px solid var(--ink);border-radius:10px;padding:15px 30px;cursor:pointer;transition:all .3s cubic-bezier(.4,0,.2,1)}
  .rq-btn:hover:not(:disabled){background:var(--rq-yellow);border-color:var(--rq-yellow);color:#0a0a0a;transform:translateY(-2px);box-shadow:0 30px 60px -28px rgba(10,10,10,.45)}
  .rq-btn:disabled{opacity:.4;cursor:not-allowed}
  .rq-err{color:var(--rq-err);font-size:13px;margin:0}
  .rq-done{display:grid;gap:14px;justify-items:center;padding:12px 0 6px}
  .rq-kick{display:inline-flex;align-items:center;gap:9px;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--rq-muted);margin:0}
  .rq-kick::before{content:"";width:8px;height:8px;border-radius:99px;background:var(--rq-gold);box-shadow:0 0 0 3px rgba(184,145,47,.22)}
  .rq-done h3{font-size:clamp(36px,8vw,48px);line-height:.9}
  .rq-sub{font-size:15px;color:var(--rq-muted);max-width:36ch;margin:0}
  @media (prefers-reduced-motion:reduce){.rq *{transition:none!important}.rq-btn:hover{transform:none}}
</style>
