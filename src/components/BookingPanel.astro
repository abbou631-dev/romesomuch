---
import type { CollectionEntry } from "astro:content";
import Bokun from "./Bokun.astro";
import { cancellationDefault, money } from "../lib/site";

interface Props { exp: CollectionEntry<"experiences"> }
const { exp } = Astro.props;
const d = exp.data;
---
<aside>
  <Bokun productId={d.bokunProductId} embed={d.bokunEmbed} price={d.price} unit={d.unit} durationLabel={d.durationLabel} policy={d.cancellationPolicy ?? cancellationDefault} />
</aside>

<div class="mbar" id="mbar">
  <div class="p"><span>From · live availability</span><b class="tnum">{money(d.price)}</b></div>
  <button class="btn" type="button" id="mbarCta">See calendar</button>
</div>

<script>
  document.body.classList.add("has-bar");
  document.getElementById("mbarCta")?.addEventListener("click", () => {
    document.getElementById("bokunBox")?.scrollIntoView({ behavior: "smooth", block: "start" });
  });
</script>
