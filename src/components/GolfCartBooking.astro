---
/**
 * Golf cart booking box: drop-in replacement for the Bókun widget
 * in the "LIVE AVAILABILITY / BOOK INSTANTLY" sidebar.
 *
 * Usage:  <GolfCartBooking tour="vip" />   // "vip" | "night" | "oneday"
 *
 * Prices, availability, payment and confirmation emails are all handled
 * inside the iframe. Do not hardcode prices anywhere on the page.
 */
interface Props { tour: 'vip' | 'night' | 'oneday'; guests?: number }
const { tour, guests = 2 } = Astro.props;
const DESK = 'https://romebycart.com/partners/romesomuch/book.html';
const src = `${DESK}?tour=${tour}&guests=${guests}&head=0`;   // head=0: the page already shows title + price above the box
const id = `golfcart-booking-${tour}`;
---
<div class="golfcart-booking">
  <iframe
    id={id}
    src={src}
    title="Book your golf cart tour"
    loading="lazy"
    allow="payment *"
    style="width:100%;border:0;display:block;min-height:600px;background:transparent"
  ></iframe>
</div>

<script is:inline define:vars={{ id }}>
  (function () {
    var ORIGIN = 'https://romebycart.com';
    window.addEventListener('message', function (e) {
      if (e.origin !== ORIGIN || !e.data || typeof e.data !== 'object') return;
      var f = document.getElementById(id);
      if (!f || e.source !== f.contentWindow) return;
      // 1) auto height: the box grows/shrinks with each step
      if (e.data.type === 'rsm-golfcart-height' && e.data.height) {
        f.style.height = Math.max(400, Math.ceil(e.data.height)) + 'px';
      }
      // 2) booking completed: goes through the site's consent-aware tracker,
      //    never straight to fbq, so it only fires once the visitor has agreed.
      if (e.data.type === 'rsm-golfcart-booked') {
        try {
          window.rsmTrack && window.rsmTrack('Purchase', {
            content_type: 'product',
            content_ids: [e.data.tour],
            value: e.data.value,
            currency: e.data.currency || 'EUR',
          });
        } catch (err) {}
      }
    });
  })();
</script>
