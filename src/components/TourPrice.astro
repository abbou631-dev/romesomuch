---
/**
 * The price of one of our own experiences, as the CRM's Tour section sets it.
 * The page ships with the price written in the content (so it reads right
 * with no JavaScript and for search engines), then /api/tours/prices replaces
 * it with the live one. The nearest [data-price] ancestor (a card) gets the
 * number too, so listing filters and sorting follow.
 *
 * Usage:  <TourPrice slug="vespa-tour" price={90} unit="person" />
 */
import { money } from "../lib/site";

interface Props { slug: string; price: number; unit: "person" | "group"; perWord?: boolean }
const { slug, price, unit, perWord = false } = Astro.props;
const unitText = (u: string) => (perWord ? `per ${u === "group" ? "boat" : "person"}` : `/ ${u}`);
---
<span class="tour-price" data-tour-price={slug} data-per={perWord ? "1" : ""}><span class="v tnum">{money(price)}</span>{" "}<span class="u">{unitText(unit)}</span></span>

<script is:inline>
  (function () {
    if (window.__tourPrices) return; window.__tourPrices = 1;
    function run() {
      var els = Array.prototype.slice.call(document.querySelectorAll("[data-tour-price]"));
      if (!els.length) return;
      fetch("/api/tours/prices")
        .then(function (r) { return r.json(); })
        .then(function (all) {
          els.forEach(function (el) {
            var t = all[el.getAttribute("data-tour-price")];
            if (!t) return;
            var euros = t.price / 100;
            var unit = el.getAttribute("data-per") ? "per " + (t.unit === "group" ? "boat" : "person") : "/ " + t.unit;
            el.querySelector(".v").textContent = "€" + (euros % 1 ? euros.toFixed(2) : euros);
            el.querySelector(".u").textContent = unit;
            var card = el.closest("[data-price]");
            if (card) card.setAttribute("data-price", String(euros));
          });
          document.dispatchEvent(new CustomEvent("prices:live"));
        })
        .catch(function () { /* the written price stays */ });
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", run); else run();
  })();
</script>
