---
// One form, two uses. The field list comes from the page, the posting and the
// validation live in functions/api/enquiry.js.
type Field = {
  name: string;
  label: string;
  type?: "text" | "email" | "url" | "textarea" | "date";
  required?: boolean;
  help?: string;
  // Date fields only: earliest day offered, and whether weekdays are refused.
  min?: string;
  weekendsOnly?: boolean;
};

interface Props {
  kind: "contact" | "creator" | "partner" | "booking";
  fields: Field[];
  submit: string;
  // Values the visitor never types — which experience they are asking about.
  hidden?: Record<string, string>;
}
const { kind, fields, submit, hidden = {} } = Astro.props;
---
<form class="enq" method="post" action="/api/enquiry">
  <input type="hidden" name="kind" value={kind} />
  {Object.entries(hidden).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
  {/* Bots fill everything in; people never see this. */}
  <p class="enq-trap" aria-hidden="true">
    <label>Leave this empty<input type="text" name="website_url" tabindex="-1" autocomplete="off" /></label>
  </p>

  {fields.map(({ name, label, type = "text", required, help, min, weekendsOnly }) => (
    <p class="enq-row">
      <label for={`${kind}-${name}`}>
        {label}{required && <span class="enq-req" aria-hidden="true">*</span>}
      </label>
      {help && <span class="enq-help">{help}</span>}
      {type === "textarea" ? (
        <textarea id={`${kind}-${name}`} name={name} rows="6" required={required}></textarea>
      ) : (
        <input
          id={`${kind}-${name}`}
          name={name}
          type={type}
          required={required}
          min={min}
          data-weekends={weekendsOnly ? "" : undefined}
        />
      )}
    </p>
  ))}

  <p class="enq-fine">
    We use what you send only to answer you. See the <a href="/legal/privacy/">privacy policy</a>.
  </p>
  <p class="enq-actions">
    <button class="btn" type="submit">{submit}</button>
    <span class="enq-msg" role="status" aria-live="polite"></span>
  </p>
</form>

<script>
  // A date input cannot grey out weekdays on its own, so the field says no itself
  // rather than letting someone ask for a Tuesday and hear about it two days later.
  document.querySelectorAll<HTMLInputElement>("input[type=date][data-weekends]").forEach((input) => {
    const check = () => {
      if (!input.value) return input.setCustomValidity("");
      // Parsed as UTC, which is what the value already is — no timezone drift.
      const day = new Date(`${input.value}T00:00:00Z`).getUTCDay();
      const weekend = day === 0 || day === 6;
      input.setCustomValidity(weekend ? "" : "We run this on Saturdays and Sundays only.");
      input.reportValidity();
    };
    input.addEventListener("change", check);
  });

  document.querySelectorAll<HTMLFormElement>("form.enq").forEach((form) => {
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const msg = form.querySelector<HTMLElement>(".enq-msg")!;
    const label = button.textContent;

    form.addEventListener("submit", async (ev) => {
      // Without JavaScript the browser posts the form itself and the endpoint
      // answers with a page, so this only takes over when it can do better.
      ev.preventDefault();
      button.disabled = true;
      button.textContent = "Sending…";
      msg.textContent = "";
      msg.classList.remove("bad");

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = await res.json();
        msg.textContent = data.message;
        if (data.ok) {
          // Only a delivered enquiry counts as a lead, and the details are
          // hashed inside rsmIdentify before anything leaves the page.
          const name = (form.querySelector<HTMLInputElement>("input[name=name]")?.value ?? "").trim();
          const space = name.indexOf(" ");
          await (window as any).rsmIdentify?.({
            email: form.querySelector<HTMLInputElement>("input[name=email]")?.value,
            firstName: space > 0 ? name.slice(0, space) : name,
            lastName: space > 0 ? name.slice(space + 1) : "",
          });
          const kind = form.querySelector<HTMLInputElement>("input[name=kind]")?.value ?? "enquiry";
          (window as any).rsmTrack?.("Lead", {
            content_name: form.querySelector<HTMLInputElement>("input[name=experience]")?.value || kind,
            content_category: kind,
          });
          form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea").forEach((f) => {
            if (f.type !== "hidden") f.value = "";
          });
        } else {
          msg.classList.add("bad");
        }
      } catch {
        msg.textContent = "Something went wrong. Please email us instead.";
        msg.classList.add("bad");
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  });
</script>
